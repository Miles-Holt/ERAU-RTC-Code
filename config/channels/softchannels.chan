# Sequence Timings
channel T-TIME
    type float
    description "T-Time of test sequence"
    units seconds
    default 0

channel SEQ-CUTOFF-T
    type float
    description "Main-valve cutoff time, absolute from sequence start (burn length = this minus valve-open time)"
    units s
    default 3.0
    min 0.5
    max 10.0

channel SEQ-IGN-LEAD
    type float
    description "Igniter lead time (before main valves open)"
    units s
    default 0.5
    min 0
    max 5.0

# Abort Limits
channel LIM-CPT01-HIGH
    type float
    description "Chamber pressure high abort threshold"
    units psia
    default 450
    min 0
    max 2000

channel LIM-CPT01-LOW
    type float
    description "Chamber pressure low abort threshold"
    units psia
    default 50
    min 0
    max 500

# Machine state channels are auto-generated per compiled machine:
#   SM-<NAME>-STATE   read-only, current state index
#   SM-<NAME>-TARGET  operator-commandable target state
# The old single-machine SYS-STATE / SYS-TARGET-STATE pair is gone.
